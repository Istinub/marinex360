# MarineX360 — local dev environment template.
# Copy to `.env` (git-ignored) before running. The single rule that protects the cloud
# migration: every local/cloud difference lives HERE as an env var — nothing hardcoded.
# Moving to AWS is a value change in this file, not a code change.

# --- Database (local Postgres -> AWS RDS later) ---
# App runtime — NON-OWNER role. Cannot UPDATE/DELETE immutable tables.
DATABASE_URL=postgresql://marinex_app:localdev_app@localhost:5432/marinex360
# Owner role — migrations, Prisma Studio, seed (DDL + full DML).
DIRECT_DATABASE_URL=postgresql://marinex:localdev@localhost:5432/marinex360
SHADOW_DATABASE_URL=postgresql://marinex:localdev@localhost:5432/marinex360_shadow

# --- Redis (local -> AWS ElastiCache later). Serves cache + BullMQ. ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO -> AWS S3 later) ---
S3_ENDPOINT=http://localhost:9000      # leave UNSET (or set to AWS endpoint) in cloud
S3_REGION=ap-southeast-1               # keep SG even locally, for parity (PDPA residency)
S3_BUCKET=marinex360-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true               # REQUIRED for MinIO; set false for AWS S3

# --- Auth (JWT short access + rotating refresh; TOTP MFA) ---
# Dev-only placeholder secrets. Real secrets come from AWS Secrets Manager in cloud.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TTL=900                         # 15 min
REFRESH_TTL=2592000                    # 30 days
TOTP_ISSUER=MarineX360

# --- Email (maildev locally -> SendGrid/SES later). FR-60 / FR-61. ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=                             # maildev needs none
SMTP_PASSWORD=
EMAIL_FROM="MarineX360 <no-reply@marinex.local>"

# --- App ---
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug
DEFAULT_TIMEZONE=Asia/Singapore        # SGT display; timestamps stored UTC (NFR-10)


